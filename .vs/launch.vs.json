{
  "version": "0.2.1",
  "configurations": [
    {
      "name": "Blender STEP Exporter",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "F:/Program Files/Blender Foundation/Blender 4.2/blender.exe",
      "args": [
        "--python-expr",
        "import bpy; print('Debug mode: Ready to test STEP export')"
      ],
      "cwd": "${workspaceRoot}",
      "environment": [
        {
          "name": "PYTHONPATH",
          "value": "${workspaceRoot}/build;${workspaceRoot}/python"
        }
      ],
      "console": "integratedTerminal"
    }
  ]
}
